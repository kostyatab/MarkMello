<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Product>MarkMello</Product>
    <Authors>MarkMello contributors</Authors>
    <Copyright>(c) 2026 MarkMello contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
  <PropertyGroup Label="Naiad maintenance fee">
    <!-- Naiad's NuGet binaries fall under the Open Source Maintenance Fee.
         MarkMello is a free GPL project with no revenue, which is the
         publisher's own "SmallRevenue" exemption (under US$10,000 a year).
         SponsorCheck reports the claim as warning SC031 on every build; it is
         a notice, not a defect, so it stays out of TreatWarningsAsErrors.
         Revisit if the project ever earns money (ADR-0005 Decision 11). -->
    <Papyrine_SponsorshipExemption>SmallRevenue</Papyrine_SponsorshipExemption>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);SC031</MSBuildWarningsAsMessages>
  </PropertyGroup>
</Project>
