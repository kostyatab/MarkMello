<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MarkMello.Desktop</RootNamespace>
    <AssemblyName>MarkMello</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MarkMello.Presentation\Assets\Icons\markmello.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <MarkMelloReleaseOwner Condition="'$(MarkMelloReleaseOwner)' == ''">dartdavros</MarkMelloReleaseOwner>
    <MarkMelloReleaseRepo Condition="'$(MarkMelloReleaseRepo)' == ''">MarkMello</MarkMelloReleaseRepo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>false</InvariantGlobalization>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3053</WarningsNotAsErrors>
    <CompressSymbols Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">false</CompressSymbols>
    <DebugSymbols Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">false</DebugSymbols>
    <DebugType Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Apple's linker asserts on large addends in arm64 AOT objects before .NET 10.0.12 (dotnet/runtime#119380). -->
  <Target Name="CheckMacOSArm64AotRuntime"
          BeforeTargets="PrepareForPublish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'osx-arm64' and $([MSBuild]::VersionLessThan('$(BundledNETCoreAppPackageVersion)', '10.0.12'))">
    <Error Text="Native AOT for osx-arm64 needs .NET SDK 10.0.401 or newer (runtime 10.0.12+), found runtime $(BundledNETCoreAppPackageVersion). Older ones break Apple's linker, see dotnet/runtime#119380." />
  </Target>

  <!-- Without the 26+ SDK stamp macOS draws the window with legacy traffic lights. -->
  <PropertyGroup>
    <MarkMelloStampSdkScript>$(MSBuildThisFileDirectory)../../packaging/macos/stamp-sdk-version.sh</MarkMelloStampSdkScript>
    <MarkMelloTargetsMacOS>false</MarkMelloTargetsMacOS>
    <MarkMelloTargetsMacOS Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx')))">true</MarkMelloTargetsMacOS>
  </PropertyGroup>

  <Target Name="StampMacOSSdkVersionAfterBuild"
          AfterTargets="Build"
          Condition="$(MarkMelloTargetsMacOS) and Exists('$(TargetDir)$(AssemblyName)')">
    <Exec Command="bash &quot;$(MarkMelloStampSdkScript)&quot; &quot;$(TargetDir)$(AssemblyName)&quot;"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="StampMacOSSdkVersionAfterPublish"
          AfterTargets="Publish"
          Condition="$(MarkMelloTargetsMacOS) and Exists('$(PublishDir)$(AssemblyName)')">
    <Exec Command="bash &quot;$(MarkMelloStampSdkScript)&quot; &quot;$(PublishDir)$(AssemblyName)&quot;"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MarkMello.Application\MarkMello.Application.csproj" />
    <ProjectReference Include="..\MarkMello.Domain\MarkMello.Domain.csproj" />
    <ProjectReference Include="..\MarkMello.Infrastructure\MarkMello.Infrastructure.csproj" />
    <ProjectReference Include="..\MarkMello.Presentation\MarkMello.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MarkMelloReleaseOwner</_Parameter1>
      <_Parameter2>$(MarkMelloReleaseOwner)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MarkMelloReleaseRepo</_Parameter1>
      <_Parameter2>$(MarkMelloReleaseRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
