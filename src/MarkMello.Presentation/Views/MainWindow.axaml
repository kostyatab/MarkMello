<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MarkMello.Presentation.ViewModels"
        xmlns:views="using:MarkMello.Presentation.Views"
        mc:Ignorable="d"
        x:Class="MarkMello.Presentation.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="840"
        WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="480"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Icons/markmello.ico"
        Background="{DynamicResource MmBackgroundBrush}"
        DragDrop.AllowDrop="True"
        UseLayoutRounding="True">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ShellViewModel"
                  x:DataType="vm:ShellViewModel">
      <views:ViewerView />
    </DataTemplate>
    <DataTemplate DataType="vm:EditorSessionViewModel"
                  x:DataType="vm:EditorSessionViewModel">
      <views:EditWorkspaceView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewDocumentCommand}" />
    <KeyBinding Gesture="Cmd+N" Command="{Binding CreateNewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Cmd+Shift+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Cmd+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Cmd+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding ActivateNextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding ActivatePreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleEditModeCommand}" />
    <KeyBinding Gesture="Cmd+E" Command="{Binding ToggleEditModeCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Cmd+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Cmd+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Cmd+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFindBarCommand}" />
    <KeyBinding Gesture="Cmd+F" Command="{Binding ToggleFindBarCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearErrorCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Border.mm-top-chrome">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translate(0px,-4px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window:pointerover Border.mm-top-chrome">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translate(0px,0px)" />
    </Style>
    <Style Selector="Window.mm-overlay-open Border.mm-top-chrome">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translate(0px,0px)" />
    </Style>

    <Style Selector="Border.mm-status">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window:pointerover Border.mm-status">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.mm-dialog-destructive">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.mm-dialog-destructive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Border.mm-external-change">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 12 40 -8 #29383C28" />
      <Setter Property="ZIndex" Value="4" />
    </Style>
    <Style Selector="Border.mm-external-change TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    </Style>

    <Style Selector="Button.mm-external-change-action">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    </Style>
    <Style Selector="Button.mm-external-change-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MmSurfaceHoverBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource MmTextBrush}" />
    </Style>

    <Style Selector="Border.mm-progress">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window:pointerover Border.mm-progress">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </Window.Styles>

  <!-- Hairline around the whole window. Without it a light window on a light
       background has no visible edge, so two overlapping documents read as one
       surface. Thickness comes from the code-behind: it depends on the setting,
       the platform and the window state. -->
  <Border Name="WindowBorder"
          BorderBrush="{DynamicResource MmBorderBrush}"
          BorderThickness="0">
    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0"
              Height="36"
              Background="{DynamicResource MmTitleBarBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <Border Grid.Column="0"
                  Background="Transparent"
                  PointerPressed="OnTitleBarPointerPressed">
            <DockPanel Name="TitleBarContent"
                     LastChildFill="True"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center">
            <Ellipse DockPanel.Dock="Left"
                       Width="5" Height="5"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Fill="{DynamicResource MmAccentBrush}"
                       IsVisible="{Binding HasDocumentTitle}" />
              <TextBlock Text="{Binding WindowTitle}"
                         FontSize="12"
                         FontWeight="Medium"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource MmTitleBarTextBrush}" />
            </DockPanel>
          </Border>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      IsVisible="{Binding ShowCustomTitleBar}">
            <Button Classes="titlebar"
                    Click="OnMinimizeClick"
                    ToolTip.Tip="{Binding TitleBarMinimize}">
              <Path Data="M0,5 L10,5"
                    Stroke="{DynamicResource MmTitleBarTextBrush}"
                    StrokeThickness="1" />
            </Button>
            <Button Name="TitleBarMaximizeButton"
                    Classes="titlebar"
                    Click="OnMaximizeClick">
              <Grid Width="10" Height="10">
                <Path Name="TitleBarMaximizeIcon"
                      Data="M0,0 L10,0 L10,10 L0,10 Z"
                      Stroke="{DynamicResource MmTitleBarTextBrush}"
                      StrokeThickness="1"
                      Fill="Transparent" />
                <Path Name="TitleBarRestoreIcon"
                      IsVisible="False"
                      Data="M3.5,0.5 L9.5,0.5 L9.5,6.5 L7.5,6.5 M0.5,3.5 L6.5,3.5 L6.5,9.5 L0.5,9.5 Z"
                      Stroke="{DynamicResource MmTitleBarTextBrush}"
                      StrokeThickness="1"
                      Fill="Transparent" />
              </Grid>
            </Button>
            <Button Classes="titlebar close"
                    Click="OnCloseClick"
                    ToolTip.Tip="{Binding TitleBarClose}">
              <Path Data="M0,0 L10,10 M10,0 L0,10"
                    Stroke="{DynamicResource MmTitleBarTextBrush}"
                    StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Name="SidebarLayout">

        <!-- Ширину держит колонка, а не контент: GridSplitter двигает именно колонку,
             и фиксированная ширина сайдбара оставляла бы рядом с ним пустую полосу.
             Диапазон 220-340 из макета, он же в WorkspaceSidebarWidth. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="0" MaxWidth="340" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ContentControl, а не сам контрол: в single-file режиме сайдбара не должно
             быть в визуальном дереве вообще (ADR-0007 Rule 3). -->
        <ContentControl Grid.Column="0"
                        IsVisible="{Binding ShowsSidebar}"
                        Content="{Binding SidebarContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:WorkspaceSidebarView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <GridSplitter Grid.Column="1"
                      Classes="mm-editor-splitter"
                      IsVisible="{Binding ShowsSidebar}"
                      DragCompleted="OnSidebarSplitterDragCompleted"
                      ResizeDirection="Columns" />

      <Grid Grid.Column="2"
            RowDefinitions="Auto,*">

        <ContentControl Grid.Row="0"
                        IsVisible="{Binding ShowsTabStrip}"
                        Content="{Binding TabStripContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:TabStripView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

      <Panel Grid.Row="1"
             Name="BodyPanel">

        <views:WelcomeView IsVisible="{Binding IsWelcome}" />
        <views:EmptyDocumentSurfaceView IsVisible="{Binding IsEmptyDocumentSurface}" />
        <ContentControl IsVisible="{Binding IsViewer}"
                        Content="{Binding ActiveDocumentContent}" />
        <views:LoadErrorView IsVisible="{Binding IsError}" />

        <Border Name="ReadingProgressBar"
                Classes="mm-progress"
                IsVisible="{Binding IsViewer}"
                Height="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="{DynamicResource MmAccentBrush}"
                IsHitTestVisible="False" />

        <Border Classes="mm-top-chrome"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16,12,0,0"
                IsVisible="{Binding ShowsFloatingAppMenuButton}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ToggleButton Name="AppMenuTriggerButton"
                          Classes="topbar-ghost"
                          IsChecked="{Binding IsAppOverlayOpen, Mode=OneWay}"
                          Command="{Binding ToggleAppMenuCommand}"
                          ToolTip.Tip="{Binding AppMenuTooltip}">
              <views:LucideIcon Data="{DynamicResource LucideMenuGeometry}"
                                Width="14"
                                Height="14" />
            </ToggleButton>

            <!-- Зеркало шеврона из шапки сайдбара: свернуть дерево есть чем,
                 развернуть обратно — тоже. -->
            <Button Classes="topbar-ghost"
                    IsVisible="{Binding ShowsFloatingSidebarButton}"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip.Tip="{Binding AppMenuToggleSidebarHint}">
              <views:LucideIcon Data="{DynamicResource LucidePanelLeftOpenGeometry}"
                                Width="14"
                                Height="14" />
            </Button>
          </StackPanel>
        </Border>

        <Border Classes="mm-top-chrome"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="topbar-ghost"
                    Command="{Binding CycleThemeCommand}"
                    ToolTip.Tip="{Binding NextThemeHint}">
              <Panel Width="14"
                     Height="14">
                <views:LucideIcon IsVisible="{Binding ShowsMoonThemeIcon}"
                                  Data="{DynamicResource LucideMoonGeometry}"
                                  Width="14"
                                  Height="14" />
                <views:LucideIcon IsVisible="{Binding ShowsSunThemeIcon}"
                                  Data="{DynamicResource LucideSunGeometry}"
                                  Width="14"
                                  Height="14" />
              </Panel>
            </Button>

            <ToggleButton Classes="topbar-action"
                          IsVisible="{Binding ShowsEditToggle}"
                          IsChecked="{Binding IsEditMode, Mode=OneWay}"
                          Command="{Binding ToggleEditModeCommand}"
                          ToolTip.Tip="{Binding EditToggleTooltip}">
              <StackPanel Orientation="Horizontal"
                          Spacing="6"
                          VerticalAlignment="Center">
                <Panel Width="12"
                       Height="12"
                       VerticalAlignment="Center">
                  <views:LucideIcon IsVisible="{Binding ShowsEditPencilIcon}"
                                    Data="{DynamicResource LucidePenLineGeometry}"
                                    Width="12"
                                    Height="12" />
                  <views:LucideIcon IsVisible="{Binding ShowsReadEyeIcon}"
                                    Data="{DynamicResource LucideEyeGeometry}"
                                    Width="12"
                                    Height="12" />
                </Panel>
                <TextBlock Text="{Binding EditToggleLabel}"
                           FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                           FontSize="12" />
              </StackPanel>
            </ToggleButton>

            <ToggleButton Name="SettingsTriggerButton"
                          Classes="topbar-ghost"
                          IsVisible="{Binding IsViewer}"
                          Command="{Binding ToggleSettingsCommand}"
                          IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                          ToolTip.Tip="{Binding ReadingSettingsTooltip}">
              <views:LucideIcon Data="{DynamicResource LucideSettings2Geometry}"
                                Width="14"
                                Height="14" />
            </ToggleButton>
          </StackPanel>
        </Border>

        <ContentControl Name="AppMenuPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,54,0,0"
                        Content="{Binding AppMenuOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:AppMenuPanelView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="AppSettingsPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,54,0,0"
                        Content="{Binding AppSettingsOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:AppSettingsPanelView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="AppAboutPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,54,0,0"
                        Content="{Binding AppAboutOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:AppAboutPanelView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="SettingsPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,54,16,0"
                        Content="{Binding ReadingSettingsOverlayContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
              <views:ReadingSettingsPanelView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Name="FindBarHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        IsVisible="{Binding IsFindBarOpen}"
                        ZIndex="3">
          <views:FindBarView />
        </ContentControl>

        <!-- Файл изменился на диске, а во вкладке есть правки: решает пользователь -->
        <ContentControl Content="{Binding ExternalChangeContent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
        <Border Classes="mm-external-change"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding ExternalChangeTitle}"
                       VerticalAlignment="Center" />
            <Button Classes="mm-external-change-action"
                    Content="{Binding ExternalChangeReload}"
                    Command="{Binding ReloadExternalChangeCommand}" />
            <Button Classes="mm-external-change-action"
                    Content="{Binding ExternalChangeKeep}"
                    Command="{Binding KeepExternalChangeCommand}" />
          </StackPanel>
        </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <Border Classes="mm-status"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Padding="20,0,20,14"
                IsHitTestVisible="False">
          <!-- В узком окне счётчики обрезаются по отступу, а не вылезают за край окна. -->
          <StackPanel Orientation="Horizontal"
                      Spacing="18"
                      VerticalAlignment="Bottom"
                      ClipToBounds="True"
                      IsVisible="{Binding ShowsReadingStatus}">
            <TextBlock Text="{Binding WordCountStatusLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource MmTextSoftBrush}" />
            <TextBlock Text="{Binding ReadTimeStatusLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource MmTextSoftBrush}" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsDragHovering}"
                IsHitTestVisible="False"
                Background="{DynamicResource MmAccentSoftBrush}"
                BorderBrush="{DynamicResource MmAccentBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Margin="12">
          <TextBlock Text="{Binding DragDropHint}"
                     FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                     FontSize="14"
                     Foreground="{DynamicResource MmAccentBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- Подтверждение удаления: скрим начинается под тайтлбаром, окно остаётся перетаскиваемым -->
        <ContentControl Content="{Binding DeletePromptContent}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ShellViewModel">
        <Grid Background="#47201915">
          <Border Classes="mm-dialog-card"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Classes="mm-dialog-title"
                         Text="{Binding DeletePromptTitle}" />
              <TextBlock Classes="mm-dialog-body"
                         Text="{Binding DeletePromptMessage}"
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8"
                          Margin="0,18,0,0">
                <Button Classes="mm-dialog-destructive"
                        IsVisible="{Binding !IsDeleteErrorPrompt}"
                        Content="{Binding DeleteConfirmLabel}"
                        Command="{Binding ConfirmDeleteCommand}" />
                <Button Classes="mm-dialog-outline"
                        IsVisible="{Binding !IsDeleteErrorPrompt}"
                        Content="{Binding DeleteCancelLabel}"
                        Command="{Binding CancelDeleteCommand}" />
                <Button Classes="mm-dialog-outline"
                        IsVisible="{Binding IsDeleteErrorPrompt}"
                        Content="{Binding DeleteErrorCloseLabel}"
                        Command="{Binding CancelDeleteCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <Grid IsVisible="{Binding IsDirtyPromptOpen}"
              Background="#66000000">
          <Border Classes="mm-dialog-card"
                  Width="420"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Classes="mm-dialog-title"
                         Text="{Binding DirtyPromptTitle}" />
              <TextBlock Classes="mm-dialog-body"
                         Text="{Binding DirtyPromptMessage}" />
              <Border Classes="mm-dialog-error-shell"
                      IsVisible="{Binding HasDirtyPromptError}">
                <TextBlock Classes="mm-dialog-error"
                           Text="{Binding DirtyPromptErrorMessage}" />
              </Border>
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8"
                          Margin="0,18,0,0">
                <Button Classes="mm-dialog-secondary"
                        Content="{Binding DirtyPromptCancel}"
                        Command="{Binding CancelDirtyPromptCommand}" />
                <Button Classes="mm-dialog-secondary"
                        Content="{Binding DirtyPromptDiscard}"
                        Command="{Binding ConfirmDirtyDiscardCommand}" />
                <Button Classes="mm-dialog-primary"
                        Content="{Binding DirtyPromptSave}"
                        Command="{Binding ConfirmDirtySaveCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Panel>

      </Grid>

      </Grid>

    </Grid>
  </Border>

</Window>
