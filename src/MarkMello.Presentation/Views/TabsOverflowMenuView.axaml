<views:MenuCardView xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:MarkMello.Presentation.ViewModels"
                    xmlns:views="using:MarkMello.Presentation.Views"
                    mc:Ignorable="d"
                    x:Class="MarkMello.Presentation.Views.TabsOverflowMenuView"
                    ClipToBounds="False"
                    x:DataType="vm:ShellViewModel">

  <UserControl.Styles>
    <!-- Ширина списка не зависит от имён вкладок: длинное имя обрезается многоточием -->
    <Style Selector="Border.mm-tabs-overflow-panel">
      <Setter Property="Width" Value="236" />
    </Style>

    <Style Selector="TextBlock.mm-tab-overflow-header">
      <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
      <!-- Слева 10 — как отступ пунктов: заголовок стоит над их подписями -->
      <Setter Property="Margin" Value="10,4,10,6" />
    </Style>

    <!-- Шрифт, размер и цвет — от пункта меню (mm-menu-command), здесь только обрезка -->
    <Style Selector="TextBlock.mm-tab-overflow-title">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Цвет крестика не зависит от состояния кнопки, поэтому стоит на самой иконке:
         Foreground кнопки Fluent меняет по состояниям -->
    <Style Selector="Button.mm-tab-overflow-close views|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    </Style>
    <!-- Крестик проявляется под курсором строки и подменяет точку несохранённого -->
    <Style Selector="Button.mm-tab-overflow-item:pointerover Button.mm-tab-overflow-close">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.mm-tab-overflow-item:pointerover Ellipse.mm-tab-dirty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- Список скрытых вкладок «ещё N» (ADR-0009 Rule 4): та же карточка и те же пункты
       mm-menu-command, что в меню сайдбара, только раскрывается от правого края кнопки.
       mm-tab-overflow-item размеров не задаёт — по нему строка показывает ✕ под курсором. -->
  <Border Classes="mm-settings-panel mm-popover-right mm-sidebar-menu-panel mm-tabs-overflow-panel">
    <StackPanel>
      <TextBlock Classes="mm-tab-overflow-header"
                 Text="{Binding TabsOverflowHeader}" />

      <ItemsControl Name="TabsOverflowList"
                    ItemsSource="{Binding OpenDocuments.OverflowTabs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentTabViewModel">
            <Button Classes="mm-list-item mm-menu-command mm-tab-overflow-item"
                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).OpenDocuments.ActivateCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Classes="mm-tab-overflow-title"
                           Text="{Binding DisplayTitle}" />
                <!-- Скрытую вкладку можно закрыть, не делая её активной (макет 03) -->
                <Panel Grid.Column="1"
                       Width="14"
                       Height="14"
                       VerticalAlignment="Center">
                  <Ellipse Classes="mm-tab-dirty"
                           IsVisible="{Binding IsDirty}"
                           Width="6"
                           Height="6"
                           Fill="{DynamicResource MmAccentBrush}" />
                  <Button Classes="mm-icon-button mm-icon-button-bare mm-tab-overflow-close mm-menu-keep-open"
                          Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).OpenDocuments.CloseCommand}"
                          CommandParameter="{Binding}">
                    <views:LucideIcon Data="{DynamicResource LucideXGeometry}"
                                      Width="12"
                                      Height="12" />
                  </Button>
                </Panel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="mm-menu-separator" />

      <Button Name="TabsOverflowCloseOthers"
              Classes="mm-list-item mm-menu-command"
              Content="{Binding TabsCloseOthers}"
              Command="{Binding OpenDocuments.CloseOthersCommand}"
              CommandParameter="{Binding OpenDocuments.ActiveTab}" />
    </StackPanel>
  </Border>
</views:MenuCardView>
