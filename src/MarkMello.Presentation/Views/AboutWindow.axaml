<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MarkMello.Presentation.ViewModels"
        mc:Ignorable="d"
        x:Class="MarkMello.Presentation.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Icons/softmark.ico"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MmBackgroundBrush}"
        UseLayoutRounding="True">
  <!-- «О Softmark» (ADR-0009 Rule 7): настоящее окно ОС, а не оверлей — на macOS оно
       открывается из системного меню, когда карточки «Настройки» на экране нет.
       Сведения те же, что в нижней строке карточки «Настройки», плюс атрибуция
       оригинала (ADR-0011). -->
  <StackPanel HorizontalAlignment="Center"
              Margin="24,28">

    <!-- «Soft» + акцентное «mark» Inter SemiBold, как на стартовом экране. Run
         стоят вплотную: пробел между ними разбил бы слово надвое. -->
    <TextBlock FontFamily="{DynamicResource MmDocumentSansFontFamily}"
               FontSize="28"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource MmTextBrush}"
               Name="AboutWordmark"><Run Text="Soft" /><Run Text="mark" Foreground="{DynamicResource MmAccentBrush}" /></TextBlock>

    <TextBlock Name="AboutVersionLine"
               Classes="mm-app-settings-caption"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               Text="{Binding VersionLine}" />

    <TextBlock Name="AboutLicenseLine"
               Classes="mm-app-settings-caption"
               HorizontalAlignment="Center"
               Margin="0,2,0,0"
               Text="{Binding License}" />

    <TextBlock Name="AboutForkAttribution"
               Classes="mm-app-settings-caption"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,10,0,0"
               Text="{Binding ForkAttribution}" />

    <Button Name="AboutGitHubLink"
            Classes="mm-link"
            HorizontalAlignment="Center"
            Margin="0,14,0,0"
            Tag="{Binding GitHubUrl}"
            Click="OnLinkClick"
            Content="GitHub" />
  </StackPanel>
</Window>
