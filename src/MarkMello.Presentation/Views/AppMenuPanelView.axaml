<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.AppMenuPanelView"
             ClipToBounds="False"
             x:DataType="vm:ShellViewModel">
  <!-- Меню ⋯ по A-Menu (ADR-0009 Rule 4): только команды с сочетаниями и вход в настройки.
       Без папки её пункты скрыты, неприменимые команды гаснут по CanExecute. -->
  <Border Classes="mm-settings-panel mm-popover-right mm-app-menu-panel">
    <StackPanel>
      <Button Name="MenuNewDocument"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding CreateNewDocumentCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuNewDocument}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding NewDocumentShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuOpenFile"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding OpenFileCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuOpenFile}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding OpenFileShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuOpenFolder"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding OpenFolderCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuOpenFolder}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding OpenFolderShortcut}" />
        </Grid>
      </Button>
      <Border Classes="mm-menu-separator" />
      <Button Name="MenuSave"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding SaveCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuSave}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding SaveShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuSaveAs"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding SaveAsCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuSaveAs}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding SaveAsShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuReload"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding ReloadCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuReload}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding ReloadShortcut}" />
        </Grid>
      </Button>
      <Border Classes="mm-menu-separator" />
      <Button Name="MenuFilesPanel"
              Classes="mm-list-item mm-menu-command"
              IsVisible="{Binding CanToggleSidebar}"
              Command="{Binding ToggleSidebarCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuFilesPanel}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding ToggleSidebarShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuCloseTab"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding CloseActiveTabCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuCloseTab}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding CloseTabShortcut}" />
        </Grid>
      </Button>
      <Button Name="MenuCloseFolder"
              Classes="mm-list-item mm-menu-command"
              IsVisible="{Binding CanCloseFolder}"
              Command="{Binding CloseFolderCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuCloseFolderLabel}" />
        </Grid>
      </Button>
      <Border Classes="mm-menu-separator" />
      <Button Name="MenuSettings"
              Classes="mm-list-item mm-menu-command"
              Command="{Binding OpenAppSettingsCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuSettings}" />
          <TextBlock Grid.Column="1"
                     Classes="mm-menu-shortcut"
                     Text="{Binding SettingsShortcut}" />
        </Grid>
      </Button>
      <!-- На macOS «Проверить обновления…» и «О MarkMello» живут в системном меню
           приложения: здесь нет ни пунктов, ни разделителя над ними — иначе меню кончалось
           бы пустой чертой -->
      <Border Classes="mm-menu-separator"
              IsVisible="{Binding ShowsAboutMenuItem}" />
      <Button Name="MenuCheckForUpdates"
              Classes="mm-list-item mm-menu-command"
              IsVisible="{Binding ShowsAboutMenuItem}"
              Command="{Binding CheckForUpdatesCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuCheckForUpdates}" />
        </Grid>
      </Button>
      <Button Name="MenuAbout"
              Classes="mm-list-item mm-menu-command"
              IsVisible="{Binding ShowsAboutMenuItem}"
              Command="{Binding ShowAboutCommand}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <TextBlock Text="{Binding AppMenuAbout}" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
