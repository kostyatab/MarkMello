<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:views="using:MarkMello.Presentation.Views"
             xmlns:sys="using:System"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.WelcomeView"
             x:DataType="vm:ShellViewModel">

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                MaxWidth="380">

      <!-- App mark -->
      <Image Source="avares://MarkMello.Presentation/Assets/Images/logo.png"
             Width="160" Height="160"
             HorizontalAlignment="Center"
             Margin="0,0,0,-15" />

      <!-- Logo: "Mark" + accent "Mello", bold, no italic -->
      <TextBlock FontFamily="{DynamicResource MmDocumentSerifFontFamily}"
                 FontSize="44"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextBrush}">
        <Run Text="Mark" />
        <Run Text="Mello"
             Foreground="{DynamicResource MmAccentBrush}" />
      </TextBlock>

      <TextBlock Text="{Binding WelcomeTagline}"
                 FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                 FontSize="13"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextFaintBrush}"
                 Margin="0,0,0,28" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Button Classes="welcome-secondary"
                Command="{Binding CreateNewDocumentCommand}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <views:LucideIcon Data="{DynamicResource LucideFilePlusGeometry}"
                              Width="14"
                              Height="14" />
            <TextBlock Text="{Binding WelcomeCreateMd}" />
          </StackPanel>
        </Button>
        <Button Classes="welcome-secondary"
                Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <views:LucideIcon Data="{DynamicResource LucideFolderOpenGeometry}"
                              Width="14"
                              Height="14" />
            <TextBlock Text="{Binding WelcomeOpenFolder}" />
          </StackPanel>
        </Button>
        <Button Classes="welcome-primary"
                Content="{Binding WelcomeOpenFile}"
                Command="{Binding OpenFileCommand}" />
      </StackPanel>

      <!-- Hotkey hint -->
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                  Margin="0,28,0,0">
        <!-- ⌘ O на macOS, Ctrl O на Windows и Linux: каждая клавиша — своя плашка -->
        <ItemsControl ItemsSource="{Binding OpenFileShortcutKeys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Border Classes="kbd">
                <TextBlock Text="{Binding}" FontFamily="{DynamicResource MmDocumentMonoFontFamily}" FontSize="10" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding WelcomeDropHint}"
                   FontSize="11"
                   Foreground="{DynamicResource MmTextFaintBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Grid>

</UserControl>
