<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Палитра MarkMello.

    Hex значения рассчитаны напрямую из oklch() токенов дизайн-системы
    через колориметрический конвертер
    OKLab -> XYZ (D65) -> linear sRGB -> sRGB, с clamp в gamut.

    Не редактировать цвета на глаз: любой сдвиг должен идти от изменения
    соответствующего oklch(L C h) значения в комментарии над кистью.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- oklch(0.985 0.006 80) -->
      <SolidColorBrush x:Key="MmBackgroundBrush">#FCFAF6</SolidColorBrush>
      <!-- oklch(0.995 0.004 80) -->
      <SolidColorBrush x:Key="MmElevatedBackgroundBrush">#FFFDFA</SolidColorBrush>
      <!-- oklch(0.96 0.008 80) -->
      <SolidColorBrush x:Key="MmSurfaceBrush">#F5F1EC</SolidColorBrush>
      <!-- oklch(0.93 0.01 75) -->
      <SolidColorBrush x:Key="MmSurfaceHoverBrush">#ECE7E1</SolidColorBrush>
      <!-- oklch(0.90 0.01 75) -->
      <SolidColorBrush x:Key="MmBorderBrush">#E2DDD7</SolidColorBrush>
      <!-- oklch(0.94 0.008 75) -->
      <SolidColorBrush x:Key="MmBorderSoftBrush">#EEEAE5</SolidColorBrush>
      <!-- oklch(0.22 0.012 60) -->
      <SolidColorBrush x:Key="MmTextBrush">#1F1915</SolidColorBrush>
      <!-- oklch(0.45 0.012 60) -->
      <SolidColorBrush x:Key="MmTextSoftBrush">#5A544F</SolidColorBrush>
      <!-- oklch(0.62 0.010 60) -->
      <SolidColorBrush x:Key="MmTextFaintBrush">#8B8580</SolidColorBrush>
      <!-- Не-документы в дереве: на полтона темнее faint, иначе 12.5px строка
           даёт 3.2:1 на фоне сайдбара и 3.0:1 на наведённой строке -->
      <SolidColorBrush x:Key="MmTreeInertTextBrush">#6F6A65</SolidColorBrush>
      <!-- oklch(0.55 0.14 42) -->
      <SolidColorBrush x:Key="MmAccentBrush">#B35025</SolidColorBrush>
      <!-- oklch(0.94 0.04 50) -->
      <SolidColorBrush x:Key="MmAccentSoftBrush">#FFE4D4</SolidColorBrush>
      <!-- oklch(0.95 0.008 75) -->
      <SolidColorBrush x:Key="MmCodeBackgroundBrush">#F2EEE9</SolidColorBrush>
      <!-- oklch(0.90 0.008 75) -->
      <SolidColorBrush x:Key="MmCodeBorderBrush">#E1DDD8</SolidColorBrush>
      <!-- Клавиша (<kbd>): крышка светлее фона кода, край темнее его рамки,
           чтобы клавиша не читалась как inline-код -->
      <!-- oklch(0.975 0.006 80) -->
      <SolidColorBrush x:Key="MmKeyboardBackgroundBrush">#F9F6F2</SolidColorBrush>
      <!-- oklch(0.84 0.012 65) -->
      <SolidColorBrush x:Key="MmKeyboardBorderBrush">#D0C9C3</SolidColorBrush>
      <!-- oklch(0.80 0.012 60) -->
      <SolidColorBrush x:Key="MmQuoteBarBrush">#C4BCB6</SolidColorBrush>
      <!-- Selection: warm highlight aligned with accent-soft -->
      <SolidColorBrush x:Key="MmSelectionBrush">#F5D9C4</SolidColorBrush>
      <!-- Find (search): non-active matches, soft amber -->
      <SolidColorBrush x:Key="MmFindHighlightBrush">#F3E3A9</SolidColorBrush>
      <!-- Find (search): active match, stronger amber -->
      <SolidColorBrush x:Key="MmFindActiveBrush">#EDD47E</SolidColorBrush>
      <!-- Вкладки и кнопки строки окна: покой, наведение, активная -->
      <!-- oklch(0.955 0.008 75) -->
      <SolidColorBrush x:Key="MmTabBrush">#F3EFEA</SolidColorBrush>
      <!-- oklch(0.93 0.010 75) -->
      <SolidColorBrush x:Key="MmTabHoverBrush">#ECE7E1</SolidColorBrush>
      <!-- oklch(0.895 0.012 70) -->
      <SolidColorBrush x:Key="MmTabActiveBrush">#E2DBD4</SolidColorBrush>
      <!-- Скрим модальных диалогов: тёплый тёмный #201915 при 28 % -->
      <SolidColorBrush x:Key="MmScrimBrush">#47201915</SolidColorBrush>
      <!-- GitHub alerts: полоса, иконка и заголовок. Светлота и хрома — одни на
           все пять видов, различается только тон; заголовок на фоне — не ниже 4.5:1 -->
      <!-- oklch(0.53 0.13 250) -->
      <SolidColorBrush x:Key="MmAlertNoteBrush">#226FB3</SolidColorBrush>
      <!-- oklch(0.53 0.13 150) -->
      <SolidColorBrush x:Key="MmAlertTipBrush">#218041</SolidColorBrush>
      <!-- oklch(0.53 0.13 300) -->
      <SolidColorBrush x:Key="MmAlertImportantBrush">#7857AB</SolidColorBrush>
      <!-- oklch(0.53 0.12 75) -->
      <SolidColorBrush x:Key="MmAlertWarningBrush">#935F00</SolidColorBrush>
      <!-- oklch(0.53 0.15 22) -->
      <SolidColorBrush x:Key="MmAlertCautionBrush">#B23F43</SolidColorBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- oklch(0.23 0.008 60) -->
      <SolidColorBrush x:Key="MmBackgroundBrush">#201C19</SolidColorBrush>
      <!-- oklch(0.25 0.008 60) -->
      <SolidColorBrush x:Key="MmElevatedBackgroundBrush">#25211E</SolidColorBrush>
      <!-- oklch(0.28 0.010 60) -->
      <SolidColorBrush x:Key="MmSurfaceBrush">#2D2824</SolidColorBrush>
      <!-- oklch(0.32 0.012 60) -->
      <SolidColorBrush x:Key="MmSurfaceHoverBrush">#38322D</SolidColorBrush>
      <!-- oklch(0.35 0.010 60) -->
      <SolidColorBrush x:Key="MmBorderBrush">#3F3935</SolidColorBrush>
      <!-- oklch(0.30 0.010 60) -->
      <SolidColorBrush x:Key="MmBorderSoftBrush">#322D29</SolidColorBrush>
      <!-- oklch(0.92 0.008 80) -->
      <SolidColorBrush x:Key="MmTextBrush">#E7E4DF</SolidColorBrush>
      <!-- oklch(0.73 0.010 75) -->
      <SolidColorBrush x:Key="MmTextSoftBrush">#ABA7A1</SolidColorBrush>
      <!-- oklch(0.59 0.010 70) -->
      <SolidColorBrush x:Key="MmTextFaintBrush">#817C77</SolidColorBrush>
      <!-- Не-документы в дереве: значение MmTextSoftBrush, faint здесь даёт 3.5:1 -->
      <SolidColorBrush x:Key="MmTreeInertTextBrush">#ABA7A1</SolidColorBrush>
      <!-- oklch(0.72 0.12 42) -->
      <SolidColorBrush x:Key="MmAccentBrush">#E38A67</SolidColorBrush>
      <!-- oklch(0.35 0.05 42) -->
      <SolidColorBrush x:Key="MmAccentSoftBrush">#513225</SolidColorBrush>
      <!-- oklch(0.27 0.010 60) -->
      <SolidColorBrush x:Key="MmCodeBackgroundBrush">#2A2522</SolidColorBrush>
      <!-- oklch(0.33 0.010 60) -->
      <SolidColorBrush x:Key="MmCodeBorderBrush">#393430</SolidColorBrush>
      <!-- Клавиша (<kbd>): крышка светлее фона кода, край светлее его рамки -->
      <!-- oklch(0.29 0.010 60) -->
      <SolidColorBrush x:Key="MmKeyboardBackgroundBrush">#2F2A26</SolidColorBrush>
      <!-- oklch(0.43 0.012 60) -->
      <SolidColorBrush x:Key="MmKeyboardBorderBrush">#554E49</SolidColorBrush>
      <!-- oklch(0.45 0.012 60) -->
      <SolidColorBrush x:Key="MmQuoteBarBrush">#5A544F</SolidColorBrush>
      <!-- Selection: warm highlight, aligned with dark accent-soft -->
      <SolidColorBrush x:Key="MmSelectionBrush">#4B382C</SolidColorBrush>
      <!-- Find (search): non-active matches, soft amber -->
      <SolidColorBrush x:Key="MmFindHighlightBrush">#47412C</SolidColorBrush>
      <!-- Find (search): active match, stronger amber -->
      <SolidColorBrush x:Key="MmFindActiveBrush">#62542D</SolidColorBrush>
      <!-- Вкладки и кнопки строки окна: покой, наведение, активная -->
      <!-- oklch(0.27 0.010 60) -->
      <SolidColorBrush x:Key="MmTabBrush">#2A2522</SolidColorBrush>
      <!-- oklch(0.30 0.010 60) -->
      <SolidColorBrush x:Key="MmTabHoverBrush">#322D29</SolidColorBrush>
      <!-- oklch(0.36 0.012 60) -->
      <SolidColorBrush x:Key="MmTabActiveBrush">#423C37</SolidColorBrush>
      <!-- Скрим модальных диалогов: чёрный 50 % -->
      <SolidColorBrush x:Key="MmScrimBrush">#80000000</SolidColorBrush>
      <!-- GitHub alerts: тон как в светлой теме, светлота и хрома — под тёмный фон -->
      <!-- oklch(0.74 0.11 250) -->
      <SolidColorBrush x:Key="MmAlertNoteBrush">#73B0EE</SolidColorBrush>
      <!-- oklch(0.74 0.11 150) -->
      <SolidColorBrush x:Key="MmAlertTipBrush">#76BE86</SolidColorBrush>
      <!-- oklch(0.74 0.11 300) -->
      <SolidColorBrush x:Key="MmAlertImportantBrush">#B59BE6</SolidColorBrush>
      <!-- oklch(0.74 0.10 75) -->
      <SolidColorBrush x:Key="MmAlertWarningBrush">#D0A260</SolidColorBrush>
      <!-- oklch(0.74 0.13 22) -->
      <SolidColorBrush x:Key="MmAlertCautionBrush">#F28885</SolidColorBrush>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
