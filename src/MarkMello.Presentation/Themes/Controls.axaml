<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MarkMello.Presentation.Views">

  <!--
    Всплывающие подсказки. У Fluent отступы несимметричные (5 сверху, 7 снизу —
    под метрики Segoe UI), а шрифт по умолчанию ссылается на незарегистрированный
    Inter и падает в системный. Вместе это поднимало текст над центром. Inter
    из сборки центрируется в строке сам, поэтому отступы ровные.
  -->
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!-- Ghost button: полупрозрачная кнопка для top bar и welcome actions -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
  </Style>


  <Style Selector="Button.topbar-ghost">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!--
    Иконки (Views/LucideIcon) берут цвет из Foreground, как текст. Fluent сам
    перекрашивает Foreground у ContentPresenter кнопки в :pointerover, :pressed,
    :disabled и :checked, поэтому у кнопок с иконкой без подписи каждое такое
    состояние задано явно: нейтральное — цветом покоя. Порядок правил важен —
    при нескольких состояниях сразу побеждает правило ниже.
  -->
  <Style Selector="Button.topbar-ghost:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.topbar-ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.topbar-ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <!--
    Кнопки строки окна и шапки сайдбара (ADR-0009 Rule 2): иконка 30×30 без рамки
    и фона, радиус 8. Наведение — MmTabHoverBrush; кнопка нажата или её карточка
    открыта (:checked у ToggleButton) — MmTabActiveBrush. Иконка в этих состояниях
    темнеет до цвета текста; :checked стоит ниже :pointerover, чтобы открытая
    карточка держала заливку и под курсором.
  -->
  <Style Selector="Button.mm-row-button, ToggleButton.mm-row-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-row-button:disabled /template/ ContentPresenter, ToggleButton.mm-row-button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>
  <Style Selector="Button.mm-row-button:pointerover /template/ ContentPresenter, ToggleButton.mm-row-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.mm-row-button:pressed /template/ ContentPresenter, ToggleButton.mm-row-button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-row-button:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!--
    Кнопки окна Windows (свернуть / развернуть / закрыть) — системные глифы на всю
    высоту строки окна. Цвет глифа задан здесь, а не на самом Path: у крестика
    под курсором он белый на красном, как у системных кнопок.
  -->
  <Style Selector="Button.titlebar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.titlebar Path">
    <Setter Property="Stroke" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmTabHoverBrush}" />
  </Style>
  <Style Selector="Button.titlebar:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="Button.titlebar.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>
  <Style Selector="Button.titlebar.close:pointerover Path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Welcome primary / secondary buttons -->
  <Style Selector="Button.welcome-primary">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.welcome-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.welcome-secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Иконка перекрашивается вместе с подписью -->
  <Style Selector="Button.welcome-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <!-- Keyboard hint pill -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="MinHeight" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.kbd TextBlock">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="LineHeight" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!--
    Поверхность карточек под строкой окна (ADR-0009 Rule 2) — поиска, Aa, меню ⋯
    и настроек: одна на всех, чтобы карточки не расходились при правке палитры.
  -->
  <Style Selector="Border.mm-settings-panel, Border.mm-find-card">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 12 40 -8 #383C2814" />
  </Style>

  <!-- Карточка поиска по A-CollapsedFind: одна строка под кнопкой поиска -->
  <Style Selector="Border.mm-find-card">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.mm-settings-panel">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translate(0px,-6px) scale(0.96)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.mm-settings-panel.mm-popover-right">
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
  </Style>
  <Style Selector="Window.mm-reading-settings-open Border.mm-settings-panel.mm-reading-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>
  <Style Selector="Window.mm-app-menu-open Border.mm-settings-panel.mm-app-menu-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>
  <Style Selector="Window.mm-app-settings-open Border.mm-settings-panel.mm-app-settings-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>
  <Style Selector="Window.mm-app-about-open Border.mm-settings-panel.mm-app-about-panel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
  </Style>

  <Style Selector="Border.mm-settings-head-shell">
    <Setter Property="Padding" Value="18,14,18,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.mm-settings-title">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <!-- Назад и закрыть в шапке оверлеев -->
  <Style Selector="Button.mm-settings-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mm-settings-close:pressed /template/ ContentPresenter, Button.mm-settings-close:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>
  <Style Selector="Button.mm-settings-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Border.mm-settings-body-shell">
    <Setter Property="Padding" Value="12,8,12,14" />
  </Style>

  <Style Selector="Border.mm-setting-row">
    <Setter Property="Padding" Value="6,10" />
  </Style>
  <Style Selector="Line.mm-setting-divider">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Stretch" Value="Fill" />
    <Setter Property="Stroke" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="2,2" />
  </Style>

  <Style Selector="TextBlock.mm-setting-label">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.mm-setting-hint">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="TextBlock.mm-setting-body">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.mm-setting-meta">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.mm-menu-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-menu-item /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.mm-menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
  </Style>
  <Style Selector="Button.mm-menu-item:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.mm-inline-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mm-inline-link /template/ ContentPresenter">
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.mm-inline-link:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

    <Style Selector="Border.mm-segmented">
      <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  <Style Selector="ToggleButton.mm-segmented-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground"
                         Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="0:0:0.12" />
        <BoxShadowsTransition Property="BoxShadow"
                              Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:checked">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000" />
  </Style>
  <Style Selector="ToggleButton.mm-segmented-item:checked:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <!--
    Карточка Aa (A-SetAa): подпись над контролом, сегменты на всю ширину,
    размер текста — «− N px +», внизу строка к настройкам приложения.
  -->
  <Style Selector="Border.mm-view-card">
    <Setter Property="Padding" Value="16,14,16,12" />
  </Style>

  <Style Selector="TextBlock.mm-card-label">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.mm-card-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mm-card-segments">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="ToggleButton.mm-card-segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Иконка темы идёт за подписью: цвет задан у ContentPresenter во всех состояниях Fluent. -->
  <Style Selector="ToggleButton.mm-card-segment /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:checked">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="ToggleButton.mm-card-segment:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0F000000" />
  </Style>

  <Style Selector="Border.mm-card-stepper">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mm-card-step">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-card-step /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-card-step:pointerover /template/ ContentPresenter, Button.mm-card-step:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>
  <!-- На границе диапазона кнопка гаснет, а не исчезает: подпись не прыгает. -->
  <Style Selector="Button.mm-card-step:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>
  <Style Selector="Button.mm-card-step:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.mm-card-step-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- «Язык, обновления, версия · Настройки… ⌘,» — строка во всю ширину карточки -->
  <Style Selector="Button.mm-card-footer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0,0,6,6" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="-8,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-card-footer /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-card-footer:pointerover /template/ ContentPresenter, Button.mm-card-footer:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.mm-card-footer-link">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox.mm-language-select">
    <Setter Property="Width" Value="132" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox.mm-language-select:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>
  <Style Selector="ComboBox.mm-language-select:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="ComboBox.mm-language-select TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Шеврон Fluent — залитый PathIcon. Шаблонная часть та же (12×12, цвет по
       состояниям Fluent), а рисует её LucideIcon: цвет он наследует от PathIcon. -->
  <Style Selector="ComboBox.mm-language-select /template/ PathIcon#DropDownGlyph">
    <Setter Property="Template">
      <ControlTemplate>
        <views:LucideIcon Data="{DynamicResource LucideChevronDownGeometry}"
                          Width="12"
                          Height="12" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
  </Style>

  <Style Selector="Slider.mm-settings-slider">
    <Setter Property="Width" Value="130" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="{TemplateBinding Height}"
              MinHeight="{TemplateBinding MinHeight}"
              ClipToBounds="False">
          <Border Height="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="1"
                  VerticalAlignment="Center" />
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton"
                            Classes="mm-settings-slider-hitarea" />
            </Track.DecreaseButton>
            <Track.Thumb>
              <Thumb Classes="mm-settings-slider-thumb" />
            </Track.Thumb>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton"
                            Classes="mm-settings-slider-hitarea" />
            </Track.IncreaseButton>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RepeatButton.mm-settings-slider-hitarea">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Thumb.mm-settings-slider-thumb">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="MinWidth" Value="14" />
    <Setter Property="MinHeight" Value="14" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="7" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.mm-settings-slider-thumb:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>

  <Style Selector="TextBlock.mm-slider-value">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- Ползунок карточки Aa — во всю ширину; правило ниже базового, чтобы перебить его Width -->
  <Style Selector="Slider.mm-settings-slider.mm-card-slider">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.mm-editor-pane">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MinWidth" Value="280" />
  </Style>

  <Style Selector="Border.mm-editor-toolbar">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Button.mm-editor-toolbar-button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-editor-toolbar-button:pressed /template/ ContentPresenter, Button.mm-editor-toolbar-button:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>
  <Style Selector="Button.mm-editor-toolbar-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Border.mm-editor-toolbar-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.mm-editor-toolbar-label">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="Border.mm-editor-status-shell">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="TextBlock.mm-editor-status-text">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.mm-editor-textarea">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentMonoFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="23.8" />
    <Setter Property="CaretBrush" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mm-editor-textarea /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Margin" Value="36,28,36,28" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="GridSplitter.mm-editor-splitter">
    <Setter Property="Width" Value="9" />
    <Setter Property="Margin" Value="-4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Width="1"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource MmBorderBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.mm-editor-splitter:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="GridSplitter.mm-editor-splitter.dragging /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <Style Selector="Border.mm-dialog-card">
    <Setter Property="Padding" Value="22,20" />
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 16 48 -10 #25000033" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-title">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-body">
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>

  <Style Selector="Border.mm-dialog-error-shell">
    <Setter Property="Background" Value="{DynamicResource MmAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>

  <Style Selector="TextBlock.mm-dialog-error">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Button.mm-dialog-primary">
    <Setter Property="Background" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-dialog-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- Отмена в карточке удаления: обведённая, а не залитая — заливка тут у деструктивного
       действия, и две сплошные кнопки рядом спорили бы за внимание (макет 10). -->
  <Style Selector="Button.mm-dialog-outline">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-dialog-outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Button.mm-dialog-secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mm-dialog-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-md-heading">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-heading">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-paragraph">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-paragraph">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-list-bullet">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextSoftBrush}" />
  </Style>

  <Style Selector="Border.mm-md-quote">
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="Padding" Value="20,4,0,4" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmQuoteBarBrush}" />
  </Style>

  <!--
    GitHub alert (> [!NOTE] и др.) — цитата, у которой полоса и иконка в шапке
    цвета вида. Классы вида ставит MarkdownDocumentView, он же красит заголовок
    тем же ресурсом (заголовок — фрагмент текстового потока, а не TextBlock).
  -->
  <Style Selector="Border.mm-md-quote.mm-md-alert-note">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAlertNoteBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-note">
    <Setter Property="Data" Value="{DynamicResource LucideInfoGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertNoteBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-tip">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAlertTipBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-tip">
    <Setter Property="Data" Value="{DynamicResource LucideLightbulbGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertTipBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-important">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAlertImportantBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-important">
    <Setter Property="Data" Value="{DynamicResource LucideMessageSquareWarningGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertImportantBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAlertWarningBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-warning">
    <Setter Property="Data" Value="{DynamicResource LucideTriangleAlertGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertWarningBrush}" />
  </Style>
  <Style Selector="Border.mm-md-quote.mm-md-alert-caution">
    <Setter Property="BorderBrush" Value="{DynamicResource MmAlertCautionBrush}" />
  </Style>
  <Style Selector="views|LucideIcon.mm-md-alert-icon.mm-md-alert-caution">
    <Setter Property="Data" Value="{DynamicResource LucideOctagonAlertGeometry}" />
    <Setter Property="Foreground" Value="{DynamicResource MmAlertCautionBrush}" />
  </Style>

  <Style Selector="Border.mm-md-hr">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <Style Selector="Border.mm-md-codeblock">
    <Setter Property="Margin" Value="0,0,0,22" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmCodeBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource MmCodeBackgroundBrush}" />
  </Style>

  <!--
    Кнопка 24×24 с иконкой 13px; размеры и положение задаёт MarkdownDocumentView
    (иконка выравнивается по подписи языка). В покое иконка того же тона, что и
    подпись, — они читаются как пара; при наведении и фокусе с клавиатуры темнеет.
    Фон и рамка видны только при наведении. В покое и фон, и рамка — цвета блока
    кода, а не Transparent. У блока без языка кнопка стоит на первой строке кода,
    и справа под неё оставлено место: длинная строка обрезается до кнопки.
  -->
  <Style Selector="Button.mm-code-copy-button">
    <Setter Property="Background" Value="{DynamicResource MmCodeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmCodeBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.mm-code-copy-button views|LucideIcon">
    <Setter Property="Data" Value="{DynamicResource LucideCopyGeometry}" />
  </Style>

  <!-- После копирования иконка ненадолго сменяется галочкой (класс ставит MarkdownDocumentView). -->
  <Style Selector="Button.mm-code-copy-button.copied views|LucideIcon">
    <Setter Property="Data" Value="{DynamicResource LucideCheckGeometry}" />
  </Style>

  <Style Selector="Button.mm-code-copy-button:pressed /template/ ContentPresenter, Button.mm-code-copy-button:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

  <!-- MmSurfaceBrush почти сливается с фоном блока кода, поэтому здесь Elevated. -->
  <Style Selector="Button.mm-code-copy-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MmElevatedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <Style Selector="Button.mm-code-copy-button:pointerover /template/ ContentPresenter, Button.mm-code-copy-button:focus-visible /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-md-code-info">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MmDocumentSansFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.mm-md-codeblock-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-codeblock-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Border.mm-md-table">
    <!--
      Border-collapse model: no outer frame, no rounded corners. Visual structure is expressed
      purely through per-cell bottom borders below.
    -->
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Border.mm-md-table-header-cell">
    <Setter Property="Padding" Value="14,10" />
    <!-- Stronger divider directly under the header row, like `.mm-table th` border-bottom. -->
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
  </Style>

  <Style Selector="Border.mm-md-table-cell">
    <Setter Property="Padding" Value="14,10" />
    <!-- Soft divider between data rows, like `.mm-table td` border-bottom. -->
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderSoftBrush}" />
  </Style>

  <!-- Bottom row: no trailing divider. -->
  <Style Selector="Border.mm-md-table-cell.mm-md-table-cell-last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.mm-md-table-header">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-table-header">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mm-md-table-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="SelectableTextBlock.mm-md-table-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="HyperlinkButton.mm-md-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="TextBlock.mm-md-link-text">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="HyperlinkButton.mm-md-link:pointerover TextBlock.mm-md-link-text">
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Underline.mm-md-link-fallback">
    <Setter Property="Foreground" Value="{DynamicResource MmAccentBrush}" />
  </Style>

  <Style Selector="Span.mm-md-code-inline">
    <Setter Property="Background" Value="{DynamicResource MmCodeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MmTextBrush}" />
  </Style>

  <Style Selector="Border.mm-md-image-placeholder">
    <Setter Property="BorderBrush" Value="{DynamicResource MmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource MmSurfaceBrush}" />
  </Style>

  <Style Selector="TextBlock.mm-md-image-caption">
    <Setter Property="Foreground" Value="{DynamicResource MmTextFaintBrush}" />
  </Style>

</Styles>
