<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Composition">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Markdown and diagrams">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!-- 1.x is gated by SponsorCheck; the exemption is claimed in
         Directory.Build.props (ADR-0005 Decision 11). -->
    <PackageVersion Include="Naiad" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Label="Code highlighting">
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <!-- Only the grammar files are taken, at build time (ADR-0010 §6). -->
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
